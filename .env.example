# Telegram bot token from @BotFather (required)
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id from @userinfobot (required)
ADMIN_TELEGRAM_ID=
# Minutes between checks for parcels with no data yet (5..240); in transit: every 10 min, near delivery: every 3 min
POLL_INTERVAL_MINUTES=20
# Seconds between requests to the same carrier (0..60)
REQUEST_DELAY_SECONDS=3
# Timeout for carrier HTTP requests in seconds (>0..120)
HTTP_TIMEOUT_SECONDS=15
# SQLite database file
DB_PATH=data/bot.sqlite3
# Directory for rotating log files
LOG_DIR=logs
# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
# IANA time zone for message times and quiet hours
TIMEZONE=Asia/Ho_Chi_Minh
# Local hours H-H when notifications arrive silently; set empty to disable
QUIET_HOURS=22-7
# Local times for the daily order digest (comma-separated HH:MM); set empty to disable
DIGEST_TIMES=07:00,12:00,19:00,22:00
# Maximum active parcels per user (1..200)
MAX_PARCELS_PER_USER=30
# e.g. socks5h://127.0.0.1:1080 if api.telegram.org is blocked
TELEGRAM_PROXY_URL=
# Screenshot reading: claude_code (Claude Code on this PC, your Claude plan), api (Anthropic API credit)
# or agy (Gemini through agy and the local OCR proxy, scripts\install-proxy-task.ps1)
VISION_ENGINE=claude_code
# Path to claude.exe; empty = found automatically (PATH, then %USERPROFILE%\.local\bin\claude.exe)
CLAUDE_CODE_PATH=
# Claude Code model alias used for screenshots
VISION_MODEL=sonnet
# Seconds to wait for one screenshot (10..300)
VISION_TIMEOUT_SECONDS=90
# agy engine: address of the local OCR proxy (must be on this PC)
AGY_PROXY_URL=http://127.0.0.1:8765
# Read by the OCR proxy: path to agy.exe; empty = found automatically (PATH, then %LOCALAPPDATA%\agy\bin\agy.exe)
AGY_PATH=
# Read by the OCR proxy: Gemini model, and the model tried once after a failure or timeout (empty disables)
AGY_MODEL=gemini-3.8-flash-low
AGY_FALLBACK_MODEL=gemini-3.7-flash-low
# api engine only: Anthropic API key, model and optional workspace id
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_WORKSPACE_ID=
# Optional 17TRACK API token to automate tracking for carriers with slider captchas (e.g. BEST Express) or cross-border JNTX
SEVENTEEN_TRACK_KEY=
# Place lines and map pictures for parcels (true/false)
MAPS_ENABLED=true
